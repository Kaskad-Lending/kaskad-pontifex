   "isDeleted": false,
   "boundElements": [],
   "updated": 1789987779758,
   "link": null,
   "locked": false,
   "text": "Before any claim: each enclave is admitted once by Nitro attestation (registerEnclave) — the verifier proves the document, the entry pins PCR0. removeSigner revokes a key.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Before any claim: each enclave is admitted once by Nitro attestation (registerEnclave) — the verifier proves the document, the entry pins PCR0. removeSigner revokes a key.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
