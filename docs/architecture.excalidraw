   "link": null,
   "locked": false,
   "text": "KskdEntry checks ≥ threshold signatures from admitted enclaves and the 25M KSKD/day window, then mints only what is missing: cumulativeBurned − bridgedIn[recipient].",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "KskdEntry checks ≥ threshold signatures from admitted enclaves and the 25M KSKD/day window, then mints only what is missing: cumulativeBurned − bridgedIn[recipient].",
   "autoResize": true,
   "lineHeight": 1.25
  },
