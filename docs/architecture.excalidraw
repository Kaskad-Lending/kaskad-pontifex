   "isDeleted": false,
   "boundElements": [],
   "updated": 1789987779758,
   "link": null,
   "locked": false,
   "text": "The enclave reads burned[recipient] at Igra's finalized tag (latest − 768 blocks, ≈ 13 min) — never from a fresher block.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The enclave reads burned[recipient] at Igra's finalized tag (latest − 768 blocks, ≈ 13 min) — never from a fresher block.",
   "autoResize": true,
   "lineHeight": 1.25
  },
