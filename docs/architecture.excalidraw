   "link": null,
   "locked": false,
   "text": "Robinhood Safe owns both contracts: admits signers, sets expectedPcr0,\nmintLimit (25M KSKD/day) and setBridge — the hard stop.\nGuardian (watchdog bot) can only pause: mintLimit → 0; the Safe restores it.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Robinhood Safe owns both contracts: admits signers, sets expectedPcr0,\nmintLimit (25M KSKD/day) and setBridge — the hard stop.\nGuardian (watchdog bot) can only pause: mintLimit → 0; the Safe restores it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
