   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Burn on Igra, mint on Robinhood, 1:1, instant after finality. No reserve, no fees, no bridge-back, closable once.",
