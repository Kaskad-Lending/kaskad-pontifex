   "isDeleted": false,
   "boundElements": [],
   "updated": 1789987779758,
   "link": null,
   "locked": false,
   "text": "The holder calls exit(amount, recipient) on Igra — the KSKD is burned and burned[recipient] grows (exitWithPermit does it in one transaction, no prior approve).",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The holder calls exit(amount, recipient) on Igra — the KSKD is burned and burned[recipient] grows (exitWithPermit does it in one transaction, no prior approve).",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
