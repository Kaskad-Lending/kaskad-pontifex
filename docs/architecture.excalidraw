   "isDeleted": false,
   "boundElements": [],
   "updated": 1789987779758,
   "link": null,
   "locked": false,
   "text": "It signs Claim(recipient, cumulativeBurned, deadline) — EIP-712, deadline ≈ 1 h. Our relayer submits claim(…) on Robinhood and pays the gas.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It signs Claim(recipient, cumulativeBurned, deadline) — EIP-712, deadline ≈ 1 h. Our relayer submits claim(…) on Robinhood and pays the gas.",
   "autoResize": true,
   "lineHeight": 1.25
  },
